FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
RUN groupadd --system tracehunt && useradd --system --gid tracehunt tracehunt
COPY apps/api/ /app/
RUN pip install . && chown -R tracehunt:tracehunt /app
USER tracehunt
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
