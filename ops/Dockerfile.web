FROM node:22-alpine AS dependencies
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG API_INTERNAL_URL=http://api:8000
ENV API_INTERNAL_URL=$API_INTERNAL_URL
COPY --from=dependencies /app/node_modules ./node_modules
COPY apps/web/ ./
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
RUN addgroup --system --gid 1001 tracehunt && adduser --system --uid 1001 --ingroup tracehunt tracehunt
COPY --from=builder --chown=tracehunt:tracehunt /app/.next/standalone ./
COPY --from=builder --chown=tracehunt:tracehunt /app/.next/static ./.next/static
COPY --from=builder --chown=tracehunt:tracehunt /app/public ./public
USER tracehunt
EXPOSE 3000
CMD ["node", "server.js"]
