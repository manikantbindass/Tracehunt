# Docker Compose reads this file when copied to .env.
# Local development: copy it to apps/api/.env and adjust DATABASE_URL below.
DEMO_MODE=true
SEED_DEMO=true
API_KEY=

# The API and worker share this database and durable event outbox.
POSTGRES_DB=tracehunt
POSTGRES_USER=tracehunt
POSTGRES_PASSWORD=tracehunt-local-change-me
# For local Python development, leave DATABASE_URL unset to use SQLite.
# DATABASE_URL=postgresql+psycopg://tracehunt:password@localhost:5432/tracehunt
# REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MONITOR_ALLOW_PRIVATE_NETWORKS=false
RUN_WORKER=false
ERROR_THRESHOLD=5
ERROR_WINDOW_SECONDS=300
INCIDENT_COOLDOWN_SECONDS=900
MAX_BODY_BYTES=1048576
RETENTION_DAYS=30

# Optional. Without a key, analysis uses local evidence-based heuristics.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional HTTP endpoint for incident notifications.
ALERT_WEBHOOK_URL=
